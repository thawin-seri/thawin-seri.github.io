---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/projects/ProjectList.astro';
import { getGroupsWithCounts, getProjects, groupPath } from '../lib/content';
import { site, ui } from '../config';

const projects = (await getProjects()).filter((project) => project.data.featured);
const groups = await getGroupsWithCounts();
---

<Base home description={site.description}>
  <section class="max-w-wide mx-auto px-4 pt-14 pb-12 text-center md:pt-24">
    <h1 class="font-ui text-[clamp(3rem,11vw,6.5rem)] leading-[0.95] tracking-[-0.015em]">
      {site.name}
    </h1>
    {site.quote && (
      <figure class="mx-auto mt-8 max-w-content">
        <blockquote class="font-ui text-xl italic md:text-2xl">“{site.quote.text}”</blockquote>
        <figcaption class="text-muted mt-2 text-sm">— {site.quote.by}</figcaption>
      </figure>
    )}
    <p class="text-muted max-w-content mx-auto mt-6 text-lg">{site.description}</p>
    <p class="mt-4 text-sm">
      <a href="/resume.pdf">Resume (PDF)</a>
    </p>
  </section>

  {projects.length > 0 && (
    <section class="max-w-wide mx-auto px-4">
      <div class="border-rule flex items-baseline justify-between gap-4 border-b pb-2">
        <h2 class="font-ui text-lg font-medium">Projects</h2>
        <a href="/projects" class="text-sm no-underline">All projects</a>
      </div>
      <ProjectList projects={projects} />
    </section>
  )}

  {groups.length > 0 && (
    <section class="max-w-wide mx-auto px-4 pt-20">
      <div class="border-rule flex items-baseline justify-between gap-4 border-b pb-2">
        <h2 class="font-ui text-lg font-medium">Photographs</h2>
        <a href="/collections" class="text-sm no-underline">All albums</a>
      </div>
      <ul>
        {groups.map(({ group, count }) => (
          <li class="border-rule border-b">
            <a
              href={groupPath(group)}
              class="hover:text-primary grid gap-x-6 gap-y-1 py-5 no-underline sm:grid-cols-[11rem_minmax(0,1fr)_5rem]"
            >
              <span class="font-ui text-xl leading-tight">{group.data.title}</span>
              <span class="text-muted max-w-content text-sm">{group.data.description}</span>
              <span class="text-muted text-sm tabular-nums sm:text-right">{ui.objects(count)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
